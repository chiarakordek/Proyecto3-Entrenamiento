# Copiá este archivo como .env y completá los datos de tu MySQL.
# El back crea la base si no existe y la llena con los datos de prueba si está vacía.

PORT=3010

# mysql (tu MySQL local) o sqljs (base en memoria: se pierde al cerrar, útil para probar sin MySQL)
DB_TIPO=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=proyecto3_entrenamiento

# Crea y actualiza las tablas según las entidades al arrancar (solo para desarrollo).
DB_SYNC=true

# Clave para firmar los tokens de sesión. Poné cualquier texto largo y no lo compartas.
JWT_SECRET=cambiar-por-un-texto-largo-y-secreto
JWT_EXPIRA=7d

# Contraseña de los usuarios de prueba que crea la semilla.
SEMILLA_PASSWORD=entrenar123

# Origen del front, para permitir CORS si no se usa el proxy de Vite.
FRONT_URL=http://localhost:5174
